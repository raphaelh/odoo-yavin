<odoo noupdate="1">
    <record id="ir_cron_yavin_cloud_gc" model="ir.cron">
        <field name="name">Yavin Cloud: garbage-collect webhook transactions</field>
        <field name="model_id" ref="model_yavin_cloud_transaction"/>
        <field name="state">code</field>
        <field name="code">model._yavin_gc_old_transactions()</field>
        <field name="interval_number">1</field>
        <field name="interval_type">days</field>
        <field name="active" eval="True"/>
    </record>
</odoo>
